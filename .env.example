# ---- Supabase (create a project at supabase.com, free tier) ----
# Public anon key — safe to expose to browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key — server-only, NEVER expose to browser. Used by workers + server actions.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ---- Gemini (free tier at https://aistudio.google.com/app/apikey) ----
# Only needed for v1 (AI enrichment). Leave blank for v0.1.
GEMINI_API_KEY=

# ---- Worker config ----
# Optional override; defaults to FairEconomy this-week URL
FAIRECONOMY_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json
